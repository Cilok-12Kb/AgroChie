# Salin file ini menjadi .env.local lalu isi nilainya. JANGAN commit .env.local.
# Perubahan NEXT_PUBLIC_* baru terbaca setelah dev server di-restart.

# Client ID OAuth Google (nilai SAMA dengan GOOGLE_CLIENT_ID di backend; bukan rahasia).
# Kosong = tombol "Masuk dengan Google" disembunyikan.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Tujuan proxy /api/* (sisi server). Ganti bila Express ada di host lain.
API_PROXY_TARGET=http://127.0.0.1:3000

# Opsional: batas ukuran foto deteksi tanaman (MB).
NEXT_PUBLIC_DETECTION_MAX_MB=
