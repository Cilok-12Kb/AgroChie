# Salin menjadi backend/.env.test (TIDAK di-commit) lalu isi nilainya sendiri.
# Dipakai oleh: npm run test:db dan npm run migrate:test
# DATABASE_URL WAJIB menunjuk ke database yang namanya mengandung "_test".
DATABASE_URL="postgresql://agrochie:GANTI_SANDI@localhost:5432/agrochie_test?schema=public"
PORT=3000

ENGINE_URL=http://127.0.0.1:8000
ENGINE_INTERNAL_KEY=kunci-uji
GEMINI_API_KEY=isi-bila-perlu
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=
GEMINI_MAX_RETRIES=1
GEMINI_RETRY_BASE_MS=2000
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIMS=768
RAG_MIN_SCORE=0.5

# Sesi: JWT_SECRET minimal 32 karakter acak (boleh beda dari .env utama)
JWT_SECRET=ganti-dengan-teks-acak-minimal-32-karakter
JWT_TTL_DAYS=7
GUEST_TTL_HOURS=24
COOKIE_NAME=agro_session
FRONTEND_ORIGIN=http://localhost:3001
TRUST_PROXY=false
SEED_BANK_NAME=
SEED_BANK_PHONE=
SEED_BANK_PASSWORD=
NODE_ENV=test

# Email & Google: tes TIDAK mengirim SMTP sungguhan (memakai jsonTransport) dan TIDAK memanggil Google.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AgroChie <no-reply@example.com>"
APP_BASE_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFY_TTL_HOURS=24

AGROCHIE_UPLOAD_DIR=./uploads

GEMINI_TIMEOUT_MS=30000
DETECTION_PROVIDER=engine
DETECTION_FALLBACK_PROVIDER=
DETECTION_MIN_MARGIN=0.15
DETECTION_MIN_CONFIDENCE=0.5
DETECTION_MAX_MB=5
