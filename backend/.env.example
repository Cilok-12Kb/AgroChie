DATABASE_URL="postgresql://agrochie:GANTI_SANDI@localhost:5432/agrochie?schema=public"
PORT=3000

ENGINE_URL=http://127.0.0.1:8000
ENGINE_INTERNAL_KEY=kunci-yang-sama-dengan-engine/.env
GEMINI_API_KEY=isi-di-bagian-14
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIMS=768
RAG_MIN_SCORE=0.5
# Bagian 17: sesi. JWT_SECRET minimal 32 karakter acak; jangan dibagikan.
JWT_SECRET=ganti-dengan-teks-acak-minimal-32-karakter
JWT_TTL_DAYS=7
GUEST_TTL_HOURS=24
COOKIE_NAME=agro_session
FRONTEND_ORIGIN=http://localhost:3001
# TRUST_PROXY: false (bawaan), true, atau jumlah hop proxy (bilangan bulat > 0)
TRUST_PROXY=false
# Seed petugas bank (opsional; bila ada yang kosong, seed akun ini dilewati)
SEED_BANK_NAME=
SEED_BANK_PHONE=
SEED_BANK_PASSWORD=
NODE_ENV=development

# Local photo storage (development only)
AGROCHIE_UPLOAD_DIR=./uploads

# Deteksi kualitas tanaman
# Batas waktu satu panggilan Gemini (milidetik, > 0)
GEMINI_TIMEOUT_MS=30000
# Penyedia deteksi foto: engine (model CNN sendiri, bawaan) atau gemini
# Dengan engine tanpa fallback, panggilan Gemini per analisis hanya 1 (solusi); kasus terburuk 2 bila JSON solusi diulang.
DETECTION_PROVIDER=engine
# Penyedia cadangan (kosong = nonaktif; nilai: gemini). Dipakai SATU kali bila engine tidak tersedia atau hasilnya
# TIDAK_YAKIN karena keyakinan rendah (juga berfungsi sebagai pemeriksa bukan-tanaman). MEMAKAI KUOTA GEMINI.
# Kasus terburuk dengan fallback gemini: 4 panggilan Gemini per analisis (deteksi 2 + solusi 2, masing-masing dengan 1 ulangan).
DETECTION_FALLBACK_PROVIDER=
# Selisih minimal skor kelas #1 dan #2 dari model engine (0..1); lebih tipis dari ini dianggap tidak yakin
DETECTION_MIN_MARGIN=0.15
# Ambang keyakinan 0..1; di bawah ini hasil dianggap tidak yakin dan pengguna diminta foto lebih jelas
DETECTION_MIN_CONFIDENCE=0.5
# Ukuran maksimal foto unggahan (MB, > 0)
DETECTION_MAX_MB=5
